---
// Component for social links with dynamic add/remove
---

<div class="bg-white border border-slate-200 rounded-lg p-8 shadow-sm">
  <div class="space-y-6">
    <div class="flex items-center gap-4 mb-8">
      <div class="flex gap-2">
        <div class="w-1.5 h-1.5 rounded-full bg-black mt-1"></div>
        <div class="w-2 h-2 rounded-full bg-black"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-black mt-1"></div>
      </div>
      <h2 class="text-3xl font-bold text-black tracking-tight">Canaux numériques</h2>
    </div>
    
    <div id="social-links-container" class="space-y-4"></div>
    
    <button
      type="button"
      id="add-social"
      class="group flex items-center gap-2 text-sm text-black hover:opacity-70 transition-opacity"
    >
      <span class="w-6 h-6 rounded-full bg-black transition-opacity flex items-center justify-center text-white text-lg leading-none">+</span>
      <span class="underline">Ajouter un canal numérique</span>
    </button>
  </div>
</div>

<script is:inline>
  (function() {
    let socialLinksCount = 0;

    function initSocialLinks() {
      const addSocialButton = document.getElementById('add-social');
      const container = document.getElementById('social-links-container');

      if (!addSocialButton || !container) {
        console.error('Social links elements not found');
        return;
      }

      function addSocialLink() {
        const id = `social-${socialLinksCount++}`;
        const socialDiv = document.createElement('div');
        socialDiv.className = 'flex gap-4 items-start fade-in';
        socialDiv.dataset.socialId = id;
        
        socialDiv.innerHTML = `
          <div class="flex-1">
            <select
              name="social_platform_${id}"
              required
              class="w-full border-b border-black focus:outline-none focus:bg-slate-50 p-2 transition-colors mb-2"
            >
              <option value="">Sélectionner un canal</option>
              <option value="instagram">Instagram</option>
              <option value="portfolio">Portfolio</option>
              <option value="linkedin">LinkedIn</option>
              <option value="tiktok">TikTok</option>
              <option value="youtube">YouTube</option>
              <option value="x">X (Twitter)</option>
              <option value="dribbble">Dribbble</option>
              <option value="behance">Behance</option>
              <option value="autre">Autre</option>
            </select>
            <input
              type="url"
              name="social_link_${id}"
              required
              placeholder="URL"
              class="w-full border-b border-black focus:outline-none focus:bg-slate-50 p-2 transition-colors"
            />
          </div>
          <button
            type="button"
            class="text-xl text-red-600 hover:opacity-70 cursor-pointer mt-2 transition-opacity"
            onclick="window.removeSocialLink('${id}')"
          >
            ×
          </button>
        `;
        
        container.appendChild(socialDiv);
      }

      window.removeSocialLink = function(id) {
        const element = document.querySelector(`[data-social-id="${id}"]`);
        if (element) element.remove();
      };

      addSocialButton.addEventListener('click', addSocialLink);
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSocialLinks);
    } else {
      initSocialLinks();
    }
  })();
</script>

<style>
  .fade-in {
    animation: fadeIn 0.3s ease-in;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
