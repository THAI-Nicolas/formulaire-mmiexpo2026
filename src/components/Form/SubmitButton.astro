---
// Submit button with validation checklist
---

<div class="space-y-6 border-t border-slate-300 pt-12 mt-16">
  <div class="flex items-center gap-4 mb-8">
    <div class="flex gap-2">
      <div class="w-1.5 h-1.5 rounded-full bg-black mt-1"></div>
      <div class="w-2 h-2 rounded-full bg-black"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-black mt-1"></div>
    </div>
    <h2 class="text-3xl font-bold text-black tracking-tight">Validation et envoi</h2>
  </div>
  
  <div class="space-y-3">
    <label class="flex items-start gap-3 cursor-pointer group">
      <input
        type="checkbox"
        name="check_required"
        required
        class="mt-1 w-5 h-5 border-2 border-black checked:bg-black checked:border-black focus:ring-0 cursor-pointer"
      />
      <span class="text-sm text-black group-hover:text-slate-700">
        Tous les champs obligatoires sont remplis
      </span>
    </label>

    <label class="flex items-start gap-3 cursor-pointer group">
      <input
        type="checkbox"
        name="check_quality"
        required
        class="mt-1 w-5 h-5 border-2 border-black checked:bg-black checked:border-black focus:ring-0 cursor-pointer"
      />
      <span class="text-sm text-black group-hover:text-slate-700">
        Les visuels sont en haute définition
      </span>
    </label>

    <label class="flex items-start gap-3 cursor-pointer group">
      <input
        type="checkbox"
        name="check_rights"
        required
        class="mt-1 w-5 h-5 border-2 border-black checked:bg-black checked:border-black focus:ring-0 cursor-pointer"
      />
      <span class="text-sm text-black group-hover:text-slate-700">
        Je reconnais avoir les droits d'utilisation des images
      </span>
    </label>

    <label class="flex items-start gap-3 cursor-pointer group">
      <input
        type="checkbox"
        name="check_consent"
        required
        class="mt-1 w-5 h-5 border-2 border-black checked:bg-black checked:border-black focus:ring-0 cursor-pointer"
      />
      <span class="text-sm text-black group-hover:text-slate-700">
        J'accepte que mes informations et œuvres soient diffusées sur le site web et les réseaux sociaux de l'exposition MMI ART 26
      </span>
    </label>
  </div>

  <div class="pt-6">
    <button
      type="submit"
      id="submit-button"
      class="group relative bg-black text-white hover:opacity-80 py-4 px-8 text-lg font-semibold transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed overflow-hidden"
      disabled
    >

      
      <span id="submit-text" class="relative z-10">Envoyer mes informations</span>
      <span id="submit-loader" class="hidden relative z-10">
        <svg class="animate-spin inline-block w-5 h-5 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        Envoi en cours...
      </span>
    </button>

    <div id="success-message" class="hidden mt-4 p-4 bg-green-50 border border-green-200 rounded">
      <p class="text-green-600 font-medium">✓ Merci ! Vos informations ont bien été enregistrées.</p>
    </div>

    <div id="error-message" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded">
      <p class="text-red-600 font-medium" id="error-text">Une erreur est survenue. Veuillez réessayer.</p>
    </div>
  </div>
</div>

<script>
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const checkboxes = document.querySelectorAll('input[type="checkbox"][name^="check_"]');

  function updateSubmitButton() {
    const allChecked = Array.from(checkboxes).every((cb) => (cb as HTMLInputElement).checked);
    if (submitButton) {
      submitButton.disabled = !allChecked;
    }
  }

  checkboxes.forEach((cb) => {
    cb.addEventListener('change', updateSubmitButton);
  });

  // Initial check
  updateSubmitButton();
</script>
